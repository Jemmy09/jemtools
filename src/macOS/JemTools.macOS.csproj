<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>JEMTools</RootNamespace>
    <AssemblyName>JemTools-macOS</AssemblyName>
    <Version>1.2.3</Version>
    <AssemblyVersion>1.2.3.0</AssemblyVersion>
    <FileVersion>1.2.3.0</FileVersion>
    <Company>JEM TOOLS</Company>
    <Product>JEM TOOLS | macOS Admin Edition</Product>
    <Copyright>Copyright © 2026 Jemmy Francisco</Copyright>
    <Description>Professional macOS Administrative Suite</Description>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <!-- Shared platform-neutral files -->
  <ItemGroup>
    <Compile Include="../Shared/Models.cs" />
    <Compile Include="../Shared/TUIEngine.cs" />
    <Compile Include="../Linux/Modules.cs" />
    <Compile Include="../macOS/Modules.cs" />
    <Compile Include="../Windows/Modules.cs" />
    <Compile Include="Program.macOS.cs" />
  </ItemGroup>

</Project>
